   "source": [
    "nums = [3,2,4]\n",
    "def twoSum(nums, target):\n",
    "   for i in range(len(nums)):\n",
    "        for j in range(len(nums)):\n",
    "            if i == j:\n",
    "                continue\n",
    "            if nums[i] + nums[j] == target:\n",
    "                return [i,j]\n",
    "\n",
    "twoSum(nums,6)"
   ]
  }
